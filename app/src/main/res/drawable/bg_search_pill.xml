<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/search_pill_focused" />
            <corners android:radius="@dimen/top_bar_pill_radius" />
            <stroke
                android:width="2.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/search_pill_bg" />
            <corners android:radius="@dimen/top_bar_pill_radius" />
            <stroke
                android:width="1.5dp"
                android:color="@color/search_pill_border" />
        </shape>
    </item>
</selector>
