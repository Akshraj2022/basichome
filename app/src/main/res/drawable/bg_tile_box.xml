<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_bg_normal" />
            <corners android:radius="@dimen/tile_radius" />
            <stroke
                android:width="@dimen/tile_border_width"
                android:color="@color/tile_border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_bg_normal" />
            <corners android:radius="@dimen/tile_radius" />
            <stroke
                android:width="@dimen/tile_border_width"
                android:color="@color/tile_border_transparent" />
        </shape>
    </item>
</selector>
