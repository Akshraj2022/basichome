<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_grid_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/safe_margin_horizontal"
    android:paddingTop="@dimen/safe_margin_vertical"
    android:paddingEnd="@dimen/safe_margin_horizontal"
    android:paddingBottom="@dimen/safe_margin_vertical">

    <!-- Top Navigation / Search Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_all_apps_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_apps_title"
            android:textColor="@color/heading_text"
            android:textSize="@dimen/heading_text_size"
            android:textStyle="bold" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <!-- Search EditText for live filtering -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/et_app_filter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/search_text"
                android:textColorHint="@color/search_text_hint"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <!-- App count display -->
        <TextView
            android:id="@+id/tv_app_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tile_label_normal"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- App Grid RecyclerView (5 columns, smooth D-pad) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_app_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

</LinearLayout>
